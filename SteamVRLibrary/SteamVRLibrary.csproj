<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Virtual Desktop Unlock</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <Product>Virtual Desktop Unlock</Product>
    <Description>Steam VR companion library and optional RE3 library integration for Virtual Desktop.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\BitrateConfiguration.cs" Link="BitrateConfiguration.cs" />
    <EmbeddedResource Include="..\assets\icon.ico" LogicalName="Status.Ready.ico" />
    <EmbeddedResource Include="..\assets\icon-stopped.ico" LogicalName="Status.Stopped.ico" />
    <EmbeddedResource Include="..\assets\icon-unloaded.ico" LogicalName="Status.Unloaded.ico" />
  </ItemGroup>
</Project>
